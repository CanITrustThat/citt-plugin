#!/usr/bin/env bash
# citt: the citt plugin. Projects of Android apps scanned by the CITT research
# service: submit, status, apps, findings, scrutiny, Researcher verdicts, feedback, custom prompts, exports, owners, usage,
# network capture runs (start, watch, stop), the capture sync of their sessions, lab mail addresses,
# native code runs and tasks, customer post-capture scripts (push, activate, status, logs, pull), and campaigns of
# capture runs (NP-2012).
# shellcheck source-path=SCRIPTDIR
set -uo pipefail

CITT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"

COMMANDS="auth whoami logout submit projects status apps app findings scrutinize verdict feedback prompt export-results export-sources owners usage captures search capture-sync capture-options capture-start capture-watch capture-stop help-requests help-answer mailbox inbox native tasks task atlas-app atlas-sdk atlas-cluster atlas-search atlas-url atlas-cohort code-search code-file scripts script-push script-activate script-deactivate script-build script-egress script-status script-logs script-pull script-run campaign"

top_help() {
  cat <<'EOF'
usage: citt <command> [options]

Commands:
  auth             sign in with a browser link (device flow)
  whoami           the signed-in account
  logout           remove the stored token
  submit           add apps to a project and queue scans
  projects         your projects with app and job counts
  status           progress of a project's scans (--wait to block)
  apps             the apps of a project with their key findings
  app              the per-app JSON of one app
  findings         the findings of a project
  scrutinize       ask for LLM scrutiny of findings
  verdict          record a Researcher verdict on a finding (no model run, no charge)
  feedback         send feedback to the CITT team, free text (Markdown recommended)
  prompt           ask one question about a build file, a store link or a package id
  export-results   download the per-app JSON of a project
  export-sources   download APKs and decompiled trees
  owners           list, add or remove project owners
  usage            this month's usage and limits
  captures         network capture runs across your projects
  search           find captured requests across the sessions of a date range (--days N)
  capture-sync     download completed capture sessions into a folder (--install-timer to repeat)
  capture-options  the phones, exit states and session lengths a capture run of an app can use
  capture-start    start a network capture run of an app on a lab phone
  capture-watch    follow a capture run to its end (--timeout, then re-run)
  capture-stop     stop a capture run
  help-requests    help requests of your capture runs (--watch to be told of new ones)
  help-answer      answer a bring-me-in request by text (the session orchestrator acts on it)
  mailbox          lab mail addresses: create one by hand, list them, show one with its emails
  inbox            lab addresses and phone numbers of your sessions; one number with its texts
  native           decompile an app's native binaries with Binary Ninja into its sources (--wait)
  tasks            submissions (scans, questions, captures, exports, native code) with status
  task             one task: status, parts, timeline and result link (--watch)
  atlas-app        an app's atlas profile: detected SDKs and owner/key clusters (raw)
  atlas-sdk        an SDK's corpus counts; --apps lists the apps carrying it
  atlas-cluster    one config-ID cluster: counts, raw value, hidden-network, member apps
  atlas-search     search the atlas app corpus
  atlas-url        search the URLs/strings indexed in every app build (--csv)
  atlas-cohort     select a cohort by SDK/fact and export its full raw records (count, preview, export)
  code-search      search the decompiled code of the indexed apps (--apps for the app list, --count for the count)
  code-file        print a file of an indexed app, or a range of its lines (PACKAGE and PATH of a code-search row)
  scripts          the script versions of a project with their image state and the active one
  script-push      check, pack and upload a script folder as the next version of a script
  script-activate  run a script version on each session of the capture runs of a project (--pending)
  script-deactivate  stop running a script after the capture runs of a project
  script-build     build the image of a script version before a capture run needs it
  script-egress    the hosts an image build of a project can reach
  script-status    the state of a run's script runs, one per session, with the reason and next step (--watch)
  script-logs      write the build or run log of a session's script run to a file
  script-pull      download and unpack the output of each session's script run of a run
  script-run       run a script version on the sessions of a capture run that have none
  campaign         campaigns of capture runs that CITT books and reviews until a deadline (draft, check, create, watch, report, pull)

Run citt <command> --help for its options. Every command takes --json.
The atlas commands need an atlas-enabled account; code-search and code-file need the code_search entitlement. The script commands need scripts enabled for the account.
EOF
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    '' | -h | --help | help)
      top_help
      exit 0
      ;;
  esac
  shift
  case " $COMMANDS " in
    *" $cmd "*) ;;
    *)
      printf 'citt: unknown command: %s (run: citt --help)\n' "$cmd" >&2
      exit 2
      ;;
  esac
  CITT_CMD="citt $cmd"
  # shellcheck source=lib/common.sh
  . "$CITT_LIB/common.sh"
  require_tools
  # shellcheck source=lib/help.sh
  . "$CITT_LIB/help.sh"
  case "$cmd" in
    auth | whoami | logout)
      # shellcheck source=lib/auth.sh
      . "$CITT_LIB/auth.sh"
      ;;
    export-results | export-sources)
      # shellcheck source=lib/cmd-export.sh
      . "$CITT_LIB/cmd-export.sh"
      ;;
    submit)
      # shellcheck source=lib/cmd-submit.sh
      . "$CITT_LIB/cmd-submit.sh"
      ;;
    projects)
      # shellcheck source=lib/cmd-projects.sh
      . "$CITT_LIB/cmd-projects.sh"
      ;;
    status)
      # shellcheck source=lib/cmd-status.sh
      . "$CITT_LIB/cmd-status.sh"
      ;;
    apps)
      # shellcheck source=lib/cmd-apps.sh
      . "$CITT_LIB/cmd-apps.sh"
      ;;
    app)
      # shellcheck source=lib/cmd-app.sh
      . "$CITT_LIB/cmd-app.sh"
      ;;
    findings)
      # shellcheck source=lib/cmd-findings.sh
      . "$CITT_LIB/cmd-findings.sh"
      ;;
    scrutinize)
      # shellcheck source=lib/question-check.sh
      . "$CITT_LIB/question-check.sh"
      # shellcheck source=lib/cmd-scrutinize.sh
      . "$CITT_LIB/cmd-scrutinize.sh"
      ;;
    verdict)
      # shellcheck source=lib/cmd-verdict.sh
      . "$CITT_LIB/cmd-verdict.sh"
      ;;
    feedback)
      # shellcheck source=lib/cmd-feedback.sh
      . "$CITT_LIB/cmd-feedback.sh"
      ;;
    prompt)
      # shellcheck source=lib/question-check.sh
      . "$CITT_LIB/question-check.sh"
      # shellcheck source=lib/tus.sh
      . "$CITT_LIB/tus.sh"
      # shellcheck source=lib/cmd-prompt.sh
      . "$CITT_LIB/cmd-prompt.sh"
      ;;
    owners)
      # shellcheck source=lib/invite-ack.sh
      . "$CITT_LIB/invite-ack.sh"
      # shellcheck source=lib/cmd-owners.sh
      . "$CITT_LIB/cmd-owners.sh"
      ;;
    usage)
      # shellcheck source=lib/cmd-usage.sh
      . "$CITT_LIB/cmd-usage.sh"
      ;;
    captures | capture-sync)
      # shellcheck source=lib/cmd-capture.sh
      . "$CITT_LIB/cmd-capture.sh"
      ;;
    search)
      # shellcheck source=lib/cmd-search.sh
      . "$CITT_LIB/cmd-search.sh"
      # shellcheck source=lib/cmd-search-bulk.sh
      . "$CITT_LIB/cmd-search-bulk.sh"
      ;;
    capture-options | capture-start | capture-watch | capture-stop)
      # shellcheck source=lib/cmd-capture.sh
      . "$CITT_LIB/cmd-capture.sh"
      # shellcheck source=lib/cmd-capture-run.sh
      . "$CITT_LIB/cmd-capture-run.sh"
      ;;
    help-requests | help-answer)
      # shellcheck source=lib/cmd-help-requests.sh
      . "$CITT_LIB/cmd-help-requests.sh"
      ;;
    mailbox)
      # shellcheck source=lib/cmd-mailbox.sh
      . "$CITT_LIB/cmd-mailbox.sh"
      ;;
    inbox)
      # shellcheck source=lib/cmd-mailbox.sh
      . "$CITT_LIB/cmd-mailbox.sh"
      # shellcheck source=lib/cmd-inbox.sh
      . "$CITT_LIB/cmd-inbox.sh"
      ;;
    native)
      # shellcheck source=lib/cmd-native.sh
      . "$CITT_LIB/cmd-native.sh"
      ;;
    tasks | task)
      # shellcheck source=lib/cmd-tasks.sh
      . "$CITT_LIB/cmd-tasks.sh"
      ;;
    atlas-app | atlas-sdk | atlas-cluster | atlas-search | atlas-url)
      # shellcheck source=lib/cmd-atlas.sh
      . "$CITT_LIB/cmd-atlas.sh"
      ;;
    atlas-cohort)
      # shellcheck source=lib/cmd-atlas-cohort.sh
      . "$CITT_LIB/cmd-atlas-cohort.sh"
      ;;
    code-search)
      # shellcheck source=lib/cmd-atlas-code.sh
      . "$CITT_LIB/cmd-atlas-code.sh"
      ;;
    code-file)
      # shellcheck source=lib/cmd-atlas-code.sh
      . "$CITT_LIB/cmd-atlas-code.sh"
      # shellcheck source=lib/cmd-code-file.sh
      . "$CITT_LIB/cmd-code-file.sh"
      ;;
    scripts | script-*)
      # shellcheck source=lib/tus.sh
      . "$CITT_LIB/tus.sh"
      # shellcheck source=lib/cmd-script.sh
      . "$CITT_LIB/cmd-script.sh"
      ;;
    campaign)
      # shellcheck source=lib/cmd-campaign.sh
      . "$CITT_LIB/cmd-campaign.sh"
      # shellcheck source=lib/cmd-campaign-arms.sh
      . "$CITT_LIB/cmd-campaign-arms.sh"
      ;;
  esac
  # stdout passes through clean (app text can hold terminal control characters); auth prints the
  # sign-in link while it waits, so it writes directly.
  case "$cmd" in
    auth) cmd_auth "$@" ;;
    export-results) cmd_export results "$@" | clean ;;
    export-sources) cmd_export sources "$@" | clean ;;
    capture-sync) cmd_capture_sync "$@" | clean ;;
    capture-options) cmd_capture_options "$@" | clean ;;
    capture-start) cmd_capture_start "$@" | clean ;;
    capture-watch) cmd_capture_watch "$@" | clean ;;
    capture-stop) cmd_capture_stop "$@" | clean ;;
    help-requests) cmd_help_requests "$@" | clean ;;
    help-answer) cmd_help_answer "$@" | clean ;;
    # search runs in this shell (TASK-642 QA Q4): the INT and TERM traps of a followed export then get a signal sent to the
    # citt process alone, not only one sent to its process group.
    search) cmd_search "$@" > >(clean) ;;
    atlas-app) cmd_atlas_app "$@" | clean ;;
    atlas-sdk) cmd_atlas_sdk "$@" | clean ;;
    atlas-cluster) cmd_atlas_cluster "$@" | clean ;;
    atlas-search) cmd_atlas_search "$@" | clean ;;
    atlas-url) cmd_atlas_url "$@" | clean ;;
    atlas-cohort) cmd_atlas_cohort "$@" | clean ;;
    code-search) cmd_code_search "$@" | clean ;;
    code-file) cmd_code_file "$@" | clean ;;
    script-push) cmd_script_push "$@" | clean ;;
    script-activate) cmd_script_activate "$@" | clean ;;
    script-deactivate) cmd_script_deactivate "$@" | clean ;;
    script-build) cmd_script_build "$@" | clean ;;
    script-egress) cmd_script_egress "$@" | clean ;;
    script-status) cmd_script_status "$@" | clean ;;
    script-logs) cmd_script_logs "$@" | clean ;;
    script-pull) cmd_script_pull "$@" | clean ;;
    script-run) cmd_script_run "$@" | clean ;;
    *) "cmd_$cmd" "$@" | clean ;;
  esac
}

main "$@"
